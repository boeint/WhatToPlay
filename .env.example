# WhatToPlay configuration.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- Database (an existing MariaDB / MySQL server) ---------------------------
# Hostname or IP of the database server. If the app runs in Docker on the same
# Docker network as the database, use the database container's name.
DB_HOST=mariadb
DB_PORT=3306
# A database and user created for this app (see README for the SQL).
DB_NAME=whattoplay
DB_USER=whattoplay
DB_PASSWORD=change-me
