# WhatToPlay configuration.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# (On Unraid you don't need this file: the template asks for these values.)

# --- Docker Compose only -------------------------------------------------------
APP_PORT=8095
TZ=UTC

# --- Database (an existing MariaDB / MySQL server) ---------------------------
# Hostname or IP of the database server. If the app runs in Docker on the same
# Docker network as the database, use the database container's name.
DB_HOST=mariadb
DB_PORT=3306
# A database and user created for this app (see README for the SQL).
DB_NAME=whattoplay
DB_USER=whattoplay
DB_PASSWORD=change-me

# --- Daily backups (optional) ---------------------------------------------------
# An export file is written to BACKUP_DIR every day at BACKUP_TIME (local time);
# the newest BACKUP_KEEP files are kept. Off when the folder doesn't exist.
# BACKUP_DIR=/backups
# BACKUP_KEEP=30
# BACKUP_TIME=03:30
